# Enforce consistent LF line endings across all platforms (WSL2 / Linux / Windows)
* text=auto eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.docx binary
*.pdf binary
*.zip binary
*.tar.gz binary

# Full-length lounge track exceeds GitHub's regular-file size limit.
public/audio/lounge.mp3 filter=lfs diff=lfs merge=lfs -text
